# Server
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Database: a standard Postgres connection string, credentials included:
DATABASE_URL=postgres://<user>:<password>@<host>:<port>/<database>

# Admin API/UI token Required Sent as `Authorization: Bearer <token>` by the admin UI.
ADMIN_API_TOKEN=replace_me


# Bulk processing
BULK_MAX_ORDERS=100
BULK_CONCURRENCY=10

# Comma-separated CORS allowlist; empty means allow all in development.
# Example: CORS_ALLOWED_ORIGINS=https://oms.example.com,https://admin.example.com
CORS_ALLOWED_ORIGINS=

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120

# UrbaneBolt UAT seed values. Keep real credentials in your local .env only.
URBANEBOLT_BASE_URL=https://uat.urbanebolt.in/api/v1
URBANEBOLT_USERNAME=
URBANEBOLT_PASSWORD=
URBANEBOLT_CUSTOMER_CODE=
URBANEBOLT_DEFAULT_SERVICE_TYPE=SDD
URBANEBOLT_DEFAULT_RETURN_EMAIL=integration@example.com
URBANEBOLT_TIMEOUT_MS=8000
URBANEBOLT_RETRY_MAX_ATTEMPTS=3
URBANEBOLT_RETRY_BASE_DELAY_MS=300
